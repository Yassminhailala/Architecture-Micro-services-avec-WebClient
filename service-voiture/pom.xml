<?xml version="1.0" encoding="UTF-8"?>
<projet xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
        https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modeleVersion>4.0.0</modeleVersion>

    <parent>
        <groupId>com.systeme.microservices</groupId>
        <artifactId>Projet-Microservices-Gestion</artifactId>
        <version>2.0.0</version>
    </parent>

    <artifactId>microservice-automobile</artifactId>
    <version>1.0.0-RELEASE</version>
    <nom>service-vehicule</nom>

    <proprietes>
        <version.java>17</version.java>
        <version.spring-cloud>2022.0.4</version.spring-cloud>
    </proprietes>

    <dependances>

        <!-- API Web et persistance -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependance>

        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependance>

        <!-- Base de données embarquée -->
        <dependance>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependance>

        <!-- Client de découverte -->
        <dependance>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependance>

        <!-- Client HTTP déclaratif -->
        <dependance>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependance>

        <!-- Hypermedia -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-hateoas</artifactId>
        </dependance>

        <!-- Tests -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependance>

        <!-- Connecteur MySQL -->
        <dependance>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependance>

        <!-- Web réactif -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependance>

        <!-- Équilibrage de charge -->
        <dependance>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependance>

    </dependances>

    <gestionDependances>
        <dependances>
            <dependance>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${version.spring-cloud}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependance>
        </dependances>
    </gestionDependances>

</projet>