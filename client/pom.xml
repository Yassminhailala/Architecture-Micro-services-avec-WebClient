<?xml version="1.0" encoding="UTF-8"?>
<projet xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
        https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modeleVersion>4.0.0</modeleVersion>

    <parent>
        <groupId>com.microservices</groupId>
        <artifactId>Projet-Microservices-TP</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>microservice-client</artifactId>
    <version>0.0.1-BETA</version>
    <nom>service-client</nom>
    <description>Microservice pour la gestion des clients</description>

    <proprietes>
        <version.java>17</version.java>
        <version.spring-cloud>2022.0.4</version.spring-cloud>
    </proprietes>

    <dependances>

        <!-- Client Eureka pour la découverte de services -->
        <dependance>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependance>

        <!-- Modules Spring Boot essentiels -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependance>

        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependance>

        <!-- Base de données en mémoire pour le développement -->
        <dependance>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependance>

        <!-- REST API automatique -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-rest</artifactId>
        </dependance>

        <!-- Monitoring et métriques -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependance>

        <!-- Outils de développement -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optionnel>vrai</optionnel>
        </dependance>

        <!-- Génération de code (getters/setters) -->
        <dependance>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optionnel>vrai</optionnel>
        </dependance>

        <!-- Tests unitaires -->
        <dependance>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependance>

        <!-- Connecteur MySQL -->
        <dependance>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependance>

    </dependances>

    <!-- Gestion des versions des dépendances cloud -->
    <gestionDependances>
        <dependances>
            <dependance>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${version.spring-cloud}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependance>
        </dependances>
    </gestionDependances>

    <construction>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <cheminsTraitementAnnotations>
                        <chemin>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </chemin>
                    </cheminsTraitementAnnotations>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </construction>

</projet>